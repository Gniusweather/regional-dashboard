+function stationDirText(deg){
+  if(deg==null||!isFinite(deg)) return '—';
+  const pts=['N','NNE','NE','ENE','E','ESE','SE','SSE','S','SSW','SW','WSW','W','WNW','NW','NNW'];
+  return pts[Math.round(((deg%360)+360)%360/22.5)%16];
+}
+function islandAverageRow(rows){
+  const live=rows.filter(r=>r && !((typeof evaluateStation==='function')&&evaluateStation(r).isStale));
+  const src=live.length?live:rows;
+  const nums=key=>{
+    const a=src.map(r=>r[key]).filter(v=>v!=null&&isFinite(Number(v))).map(Number);
+    return a.length?a.reduce((x,y)=>x+y,0)/a.length:null;
+  };
+  const degs=src.map(r=>r.wind_direction_deg).filter(v=>v!=null&&isFinite(Number(v))).map(Number);
+  let dir=null;
+  if(degs.length){
+    let x=0,y=0;
+    degs.forEach(d=>{const r=d*Math.PI/180;x+=Math.cos(r);y+=Math.sin(r);});
+    dir=(Math.atan2(y,x)*180/Math.PI+360)%360;
+  }
+  return {
+    station:'Island average',
+    temperature_c:nums('temperature_c'),
+    heat_index_c:nums('heat_index_c'),
+    humidity_percent:nums('humidity_percent')!=null?Math.round(nums('humidity_percent')):null,
+    wind_speed_knots:nums('wind_speed_knots')!=null?Math.round(nums('wind_speed_knots')*10)/10:null,
+    wind_direction_deg:dir!=null?Math.round(dir):null,
+    wind_direction_text:stationDirText(dir),
+    rain_today_mm:nums('rain_today_mm')!=null?Math.round(nums('rain_today_mm')*10)/10:null,
+    last_updated:'Avg of '+src.length+' station'+(src.length===1?'':'s')
+  };
+}
